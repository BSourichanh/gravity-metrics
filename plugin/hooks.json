{
  "gravity-metrics-session": {
    "enabled": false,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 hooks/session_start_metrics.py",
        "timeout": 5
      }
    ]
  },
  "gravity-metrics-command": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/pre_invocation_metrics.py",
        "timeout": 15
      }
    ]
  },
  "gravity-metrics-stop": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 hooks/stop_auto_record.py",
        "timeout": 10
      }
    ]
  }
}
