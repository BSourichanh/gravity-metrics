{
  "schema_version": 1,
  "id": "metrics",
  "plugin_name": "gravity-metrics",
  "role": "Collecte de metriques Antigravity, couts/tokens et signaux d'optimisation pour le mode auto",
  "storage": {
    "subdir": "metrics",
    "env_override": "GRAVITY_METRICS_HOME"
  },
  "commands": [
    "/gravity-metrics"
  ],
  "capabilities": [
    "session-telemetry",
    "cost-analytics",
    "workflow-signals"
  ],
  "ui": {
    "mode": "none",
    "target": "gravity"
  },
  "dashboard": {
    "provider_script": "scripts/dashboard_provider.py",
    "views": [
      "metrics",
      "session-detail",
      "audit-detail"
    ],
    "actions": [
      "record",
      "update",
      "update-meta",
      "ignore",
      "unignore",
      "remove"
    ]
  },
  "signals": {
    "produces": [
      "session-metrics"
    ],
    "consumes": []
  }
}
